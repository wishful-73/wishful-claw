  "shortcuts": {
    "title": "快捷键",
    "desc": "管理剪贴板增强和快速搜索的启用状态与全局快捷键",
    "clipboard": "剪贴板增强",
    "clipboardDesc": "记录剪贴板历史，并通过全局快捷键唤出窗口",
    "launcher": "快速搜索",
    "launcherDesc": "通过全局快捷键搜索并启动应用",
    "wakeShortcut": "唤起快捷键",
    "multipleHint": "支持设置多个快捷键，任意一个均可唤起",
    "recording": "请按下快捷键...",
    "save": "保存",
    "cancel": "取消",
    "modify": "修改",
    "add": "添加快捷键",
    "hint": "功能启用后才能设置和使用快捷键。点击“修改”后按下目标快捷键组合，按 ESC 取消录制。修改即时生效。",
    "clipboardIntroTitle": "关于剪贴板增强",
    "clipboardIntro": {
      "p1": "剪贴板增强是一个 ditto 风格的剪贴板历史管理器。它会自动捕获你复制的每一段文本，构建一个可搜索、跨重启不丢失的历史记录。",
      "p2": "按下全局快捷键唤出浮动面板，输入关键词搜索，方向键选择，回车即可粘贴到你正在使用的应用中——无需切换窗口，不打断当前工作。",
      "p3": "历史记录按可配置的过期时间（默认 7 天）和最大条数（默认 100 条）自动清理。仅捕获纯文本，不会存储敏感内容。",
      "p4": "一旦习惯它，你将再也不丢失任何复制过的片段。按下快捷键，找到需要的内容，粘贴，继续工作。"
    },
    "launcherIntroTitle": "关于快速搜索",
    "launcherIntro": {
      "p1": "快速搜索是一个 Spotlight 风格的应用启动器。按下全局快捷键（默认 Alt+Space）唤出搜索框，输入几个字符即可启动任何已安装的程序。",
      "p2": "支持按应用名称、英文驼峰、中文拼音、拼音首字母搜索。只要你还记得大概的名字，输入基本都能找到。",
      "p3": "除了开始菜单中的应用，你还可以添加自定义启动项来收录绿色版或未安装的程序。启动过的应用会自动记录到历史中，下次无需添加即可搜到。",
      "p4": "一旦熟悉它，能够为你节约大量时间。即用即走、不中断、无干扰，让你可以更加专注地改变世界。"
    }
  },
