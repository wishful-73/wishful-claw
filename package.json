{
  "name": "wishful-claw",
  "version": "0.2.20",
  "description": "Wishful Claw - Agent 编程软件",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:full": "dotnet build src/runtime/WishfulClaw.sln && electron-vite dev",
    "build:worker": "dotnet build src/runtime/WishfulClaw.sln",
    "build:worker:prod": "node scripts/publish-aot-worker.mjs",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "pack": "electron-vite build && electron-builder --dir",
    "pack:full": "npm run build:worker:prod && electron-vite build && electron-builder --dir",
    "pack:zip": "npm run build:worker:prod && electron-vite build && electron-builder --dir && node scripts/zip-release.mjs",
    "pack:installer": "electron-vite build && electron-builder --win",
    "pack:installer:full": "npm run build:worker:prod && electron-vite build && electron-builder --win",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@jitsi/robotjs": "^0.6.24",
    "@larksuiteoapi/node-sdk": "^1.72.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@monaco-editor/react": "^4.7.0",
    "@msgpack/msgpack": "^3.1.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.7",
    "@toon-format/toon": "^2.3.1",
    "@types/node-cron": "^3.0.11",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.6.0",
    "bufferutil": "^4.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dingtalk-stream": "^2.1.6-beta.1",
    "gpt-tokenizer": "^3.4.0",
    "i18next": "^26.3.6",
    "immer": "^11.1.15",
    "katex": "^0.18.1",
    "lucide-react": "^0.563.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.55.1",
    "motion": "^12.42.2",
    "nanoid": "^6.0.0",
    "next-themes": "^0.4.6",
    "node-cron": "^4.6.0",
    "node-pty": "^1.1.0",
    "partial-json": "^0.1.7",
    "pinyin-pro": "^3.29.2",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.4",
    "react-i18next": "^17.0.10",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.7",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "utf-8-validate": "^6.0.6",
    "ws": "^8.21.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "cpu-features": "npm:noop2@1.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
