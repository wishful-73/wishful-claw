    "dev:full": "dotnet build src/runtime/WishfulClaw.sln && electron-vite dev",
    "build:worker": "dotnet build src/runtime/WishfulClaw.sln",
    "build:worker:prod": "node scripts/publish-aot-worker.mjs",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "pack": "electron-vite build && electron-builder --dir",
    "pack:full": "npm run build:worker:prod && electron-vite build && electron-builder --dir",
    "pack:zip": "npm run build:worker:prod && electron-vite build && electron-builder --dir -c.extraMetadata.wishfulClawDistribution=green && node scripts/zip-release.mjs",
