{
  "name": "wishful-claw",
  "version": "0.2.30",
  "description": "Wishful Claw - Agent 编程软件",
  "author": "Wishful Claw",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:full": "dotnet build src/runtime/WishfulClaw.sln && electron-vite dev",
    "build:worker": "dotnet build src/runtime/WishfulClaw.sln",
    "build:worker:prod": "node scripts/publish-aot-worker.mjs",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "pack": "electron-vite build && electron-builder --dir",
    "pack:full": "npm run build:worker:prod && electron-vite build && electron-builder --dir",
    "pack:zip": "npm run build:worker:prod && electron-vite build && electron-builder --dir -c.extraMetadata.wishfulClawDistribution=green && node scripts/zip-release.mjs",
    "pack:installer": "electron-vite build && electron-builder --win",
    "pack:installer:full": "npm run build:worker:prod && electron-vite build && electron-builder --win",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:renderable-chat-items": "esbuild tests/renderable-chat-items/program.ts --bundle --platform=node --format=cjs --alias:@renderer=./src/renderer/src --outfile=tests/renderable-chat-items/out/program.cjs && node tests/renderable-chat-items/out/program.cjs",
    "test:channel-cancel-commands": "esbuild tests/channel-cancel-commands/program.ts --bundle --platform=node --format=cjs --outfile=tests/channel-cancel-commands/out/program.cjs && node tests/channel-cancel-commands/out/program.cjs",
    "test:session-follow-up": "node tests/session-follow-up-integration/program.mjs",
    "test:updater-release-notes": "esbuild tests/updater-release-notes/program.ts --bundle --platform=node --format=cjs --outfile=tests/updater-release-notes/out/program.cjs && node tests/updater-release-notes/out/program.cjs",
    "test:updater-state": "esbuild tests/updater-state/program.ts --bundle --platform=node --format=cjs --outfile=tests/updater-state/out/program.cjs && node tests/updater-state/out/program.cjs",
    "test:updater-progress": "esbuild tests/updater-state/download-progress.ts --bundle --platform=node --format=cjs --outfile=tests/updater-state/out/download-progress.cjs && node tests/updater-state/out/download-progress.cjs",
    "test:provider-presets": "esbuild tests/provider-presets/program.ts --bundle --platform=node --format=cjs --alias:@renderer=./src/renderer/src --outfile=tests/provider-presets/out/program.cjs && node tests/provider-presets/out/program.cjs",
    "test:provider-fallback": "esbuild tests/provider-fallback/program.ts --bundle --platform=node --format=cjs --alias:@renderer=./src/renderer/src --outfile=tests/provider-fallback/out/program.cjs && node tests/provider-fallback/out/program.cjs",
    "test:provider-payload": "esbuild tests/provider-payload/program.ts --bundle --platform=node --format=cjs --alias:@renderer=./src/renderer/src --outfile=tests/provider-payload/out/program.cjs && node tests/provider-payload/out/program.cjs",
    "test:session-model-resolution": "esbuild tests/session-model-resolution/program.ts --bundle --platform=node --format=cjs --alias:@renderer=./src/renderer/src --outfile=tests/session-model-resolution/out/program.cjs && node tests/session-model-resolution/out/program.cjs",
    "test:fallback-chain": "esbuild tests/fallback-chain/program.ts --bundle --platform=node --format=cjs --alias:@renderer=./src/renderer/src --outfile=tests/fallback-chain/out/program.cjs && node tests/fallback-chain/out/program.cjs",
    "test:i18n-coverage": "esbuild tests/i18n-coverage/program.ts --bundle --platform=node --format=cjs --outfile=tests/i18n-coverage/out/program.cjs && node tests/i18n-coverage/out/program.cjs",
    "test:live-cursor": "esbuild tests/live-cursor/program.ts --bundle --platform=node --format=cjs --alias:@renderer=./src/renderer/src --outfile=tests/live-cursor/out/program.cjs && node tests/live-cursor/out/program.cjs",
    "test:channel-account-label": "esbuild tests/channel-account-label/program.ts --bundle --platform=node --format=cjs --alias:@renderer=./src/renderer/src --outfile=tests/channel-account-label/out/program.cjs && node tests/channel-account-label/out/program.cjs",
    "test:settings-tabs": "esbuild tests/settings-tabs/program.ts --bundle --platform=node --format=cjs --alias:@renderer=./src/renderer/src --outfile=tests/settings-tabs/out/program.cjs && node tests/settings-tabs/out/program.cjs",
    "test:select-file-tags": "esbuild tests/select-file-tags/program.ts --bundle --platform=node --format=cjs --alias:@renderer=./src/renderer/src --outfile=tests/select-file-tags/out/program.cjs && node tests/select-file-tags/out/program.cjs",
    "test:selected-file-context": "esbuild tests/selected-file-context/program.ts --bundle --platform=node --format=cjs --alias:@renderer=./src/renderer/src --outfile=tests/selected-file-context/out/program.cjs && node tests/selected-file-context/out/program.cjs",
    "test:streaming-render-pool": "esbuild tests/streaming-render-pool/program.ts --bundle --platform=node --format=cjs --alias:@renderer=./src/renderer/src --outfile=tests/streaming-render-pool/out/program.cjs && node tests/streaming-render-pool/out/program.cjs",
    "test:channel-reply-event-policy": "esbuild tests/channel-reply-event-policy/program.ts --bundle --platform=node --format=cjs --outfile=tests/channel-reply-event-policy/out/program.cjs && node tests/channel-reply-event-policy/out/program.cjs",
    "test:ipc-msgpack-routing": "esbuild tests/ipc-msgpack-routing/program.ts --bundle --platform=node --format=cjs --outfile=tests/ipc-msgpack-routing/out/program.cjs && node tests/ipc-msgpack-routing/out/program.cjs",
    "test:channel-shell-approval": "esbuild tests/channel-shell-approval/program.ts --bundle --platform=node --format=cjs --outfile=tests/channel-shell-approval/out/program.cjs && node tests/channel-shell-approval/out/program.cjs",
    "test:browser-user-agent": "esbuild tests/browser-user-agent/program.ts --bundle --platform=node --format=cjs --outfile=tests/browser-user-agent/out/program.cjs && node tests/browser-user-agent/out/program.cjs",
    "test:free-chat-tabs": "esbuild tests/free-chat-tabs/program.ts --bundle --platform=node --format=cjs --alias:@renderer=./src/renderer/src --outfile=tests/free-chat-tabs/out/program.cjs && node tests/free-chat-tabs/out/program.cjs"
  },
