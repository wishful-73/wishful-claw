<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- AOT: 禁用反射序列化，所有类型通过源生成器注册 -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- NativeAOT 属性（写进 csproj 让编译器识别为原生发布模式） -->
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 体积优化（参考 OpenCowork 实测） -->
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <EventSourceSupport>false</EventSourceSupport>
    <MetricsSupport>false</MetricsSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WishfulClaw.Contracts\WishfulClaw.Contracts.csproj" />
    <ProjectReference Include="..\WishfulClaw.Core\WishfulClaw.Core.csproj" />
    <ProjectReference Include="..\WishfulClaw.Agent\WishfulClaw.Agent.csproj" />
    <ProjectReference Include="..\WishfulClaw.Persona\WishfulClaw.Persona.csproj" />
    <ProjectReference Include="..\WishfulClaw.Workspace\WishfulClaw.Workspace.csproj" />
    <ProjectReference Include="..\WishfulClaw.Infrastructure\WishfulClaw.Infrastructure.csproj" />
    <ProjectReference Include="..\WishfulClaw.CodeGraph\WishfulClaw.CodeGraph.csproj" />
  </ItemGroup>

</Project>
