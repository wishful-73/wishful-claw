<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WishfulClaw.AvaloniaProbe.App"
             RequestedThemeVariant="Default">

  <!-- Fluent 主题必须挂上：不挂主题的 Avalonia 窗口量出来的内存不代表真实应用，
       因为真实应用一定带主题与控件样式资源。 -->
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

</Application>
